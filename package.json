{
  "name": "penn-state-dt-extensions",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-docs.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run check:publication",
    "release:prepare": "node scripts/prepare-release.mjs",
    "build:sandbox": "tsc -p packages/extension-sandbox/tsconfig.json",
    "pretest": "npm run build:sandbox",
    "test:standalone": "node scripts/test-standalone.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "@types/node": "22.19.0",
    "jsdom": "26.1.0",
    "@types/jsdom": "21.1.7",
    "marked": "15.0.12",
    "cesium": "1.138.0"
  }
}
